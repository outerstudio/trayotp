<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleName</key>
    <string>TrayOTP</string>
    <key>CFBundleDisplayName</key>
    <string>TrayOTP</string>
    <key>CFBundleIdentifier</key>
    <string>com.outerstudio.trayotp</string>
    <key>CFBundleExecutable</key>
    <string>TrayOTP</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu bar only: no Dock icon, no app menu. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Shown when the camera is first used: only for "Scan QR Code with Camera…".
         Translated in Support/Localizations/*.lproj/InfoPlist.strings. -->
    <key>NSCameraUsageDescription</key>
    <string>TrayOTP uses the camera only while you scan a QR code, such as Google Authenticator's transfer code. Nothing is recorded or sent anywhere.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 outerstudio.com</string>
</dict>
</plist>
